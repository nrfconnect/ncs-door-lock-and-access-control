+int coap_resource_update_notify(struct coap_resource *resource, void (*update_cb)(void *),
+				void *update_arg)
+{
+	int ret;
+
+	(void)k_mutex_lock(&lock, K_FOREVER);
+	if (update_cb != NULL) {
+		update_cb(update_arg);
+	}
+	ret = coap_resource_notify(resource);
+	(void)k_mutex_unlock(&lock);
+	return ret;
+}
