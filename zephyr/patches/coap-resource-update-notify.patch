+/**
+ * @brief Utility function for calling a resource update function and indicating that this resource
+ * was updated, and the @a notify callback should be called for every registered observer. Takes
+ * the server mutex to avoid data races.
+ *
+ * @param resource Resource that is updated
+ * @param update_cb Resource update callback function (can be NULL)
+ * @param update_arg Argument passed to the resource update callback
+ *
+ * @return 0 in case of success or negative in case of error.
+ */
+int coap_resource_update_notify(struct coap_resource *resource, void (*update_cb)(void *),
+				void *update_arg);
+
