configdefault NCS_ALIRO_BLE_UWB
	default y

configdefault DOOR_LOCK_ALIRO_READER_STORAGE_GROUP_RESOLVING_KEY_SUPPORT
	default y if NCS_ALIRO_BLE_UWB

# required by Aliro persistent storage
config FLASH
	default y

config FLASH_MAP
	default y

config NVS
	default y if !SOC_FLASH_NRF_RRAM

config NVS_LOOKUP_CACHE_SIZE
	default 512 if NVS

config NVS_LOOKUP_CACHE_FOR_SETTINGS
	default y if NVS

config ZMS
	default y if SOC_FLASH_NRF_RRAM

config ZMS_LOOKUP_CACHE_SIZE
	default 512 if ZMS

config ZMS_LOOKUP_CACHE_FOR_SETTINGS
	default y if ZMS

config SETTINGS
	default y

# required by Aliro crypto
configdefault SECURE_STORAGE
	default y

config MBEDTLS_PSA_CRYPTO_STORAGE_C
	default y

# The ZMS store implementation supports only 30-bit UIDs
choice SECURE_STORAGE_ITS_STORE_IMPLEMENTATION
	default SECURE_STORAGE_ITS_STORE_IMPLEMENTATION_SETTINGS
endchoice

choice SECURE_STORAGE_ITS_TRANSFORM_AEAD_KEY_PROVIDER
	default SECURE_STORAGE_ITS_TRANSFORM_AEAD_KEY_PROVIDER_HUK_LIBRARY
endchoice

config HW_UNIQUE_KEY_WRITE_ON_CRYPTO_INIT
	default y if (SOC_NRF5340_CPUAPP || SOC_SERIES_NRF54L)

rsource "Kconfig.crypto.defconfig"
source "Kconfig.zephyr"
