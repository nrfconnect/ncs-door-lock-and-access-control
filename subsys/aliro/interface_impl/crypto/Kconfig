config DOOR_LOCK_ALIRO_INTERFACE_IMPL_CRYPTO
	bool "Aliro Interface Implementation - Crypto"
	depends on NCS_ALIRO
	depends on DOOR_LOCK_ALIRO_CRYPTO_UTILS
	depends on DOOR_LOCK_ALIRO_READER_STORAGE
	select PSA_WANT_ALG_ECDH
	select PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_GENERATE
	select PSA_WANT_ALG_HKDF
	select PSA_WANT_ALG_HMAC
	select PSA_WANT_KEY_TYPE_HMAC
	select PSA_WANT_ALG_GCM
	select PSA_WANT_GENERATE_RANDOM
	select PSA_WANT_ALG_ECB_NO_PADDING if NCS_ALIRO_BLE_UWB
	help
	  Common implementation of Aliro::Interface::Crypto.

if DOOR_LOCK_ALIRO_INTERFACE_IMPL_CRYPTO

module = DOOR_LOCK_ALIRO_INTERFACE_IMPL_CRYPTO
module-str = Door Lock Aliro Interface Implementation Crypto
source "$(ZEPHYR_BASE)/subsys/logging/Kconfig.template.log_config"

config DOOR_LOCK_ALIRO_INTERFACE_IMPL_CRYPTO_PSA_AEAD_SINGLE_PART
	bool
	default y if SOC_NRF54LM20A || SOC_NRF54LM20B
	help
	  When enabled, the single-part AEAD API is used.

if DOOR_LOCK_ALIRO_INTERFACE_IMPL_CRYPTO_PSA_AEAD_SINGLE_PART

config DOOR_LOCK_ALIRO_INTERFACE_IMPL_CRYPTO_PSA_AEAD_SINGLE_PART_BUFFER_SIZE
	int "Maximum size of the buffer used for the single-part AEAD API"
	default 256
	help
	  Maximum size of the buffer used for the single-part AEAD API.

endif # DOOR_LOCK_ALIRO_INTERFACE_IMPL_CRYPTO_PSA_AEAD_SINGLE_PART

endif # DOOR_LOCK_ALIRO_INTERFACE_IMPL_CRYPTO
